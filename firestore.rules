rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // ============================================
    // USERS COLLECTION
    // ============================================
    // Each user can only read/write their own document
    // Path: /users/{uid}
    
    match /users/{uid} {
      function isOwner() {
        return request.auth != null && request.auth.uid == uid;
      }

      // Ensure the stored uid matches the document path uid (basic integrity)
      function hasMatchingUid() {
        return request.resource.data.uid == uid;
      }

      function isSafePhotoUrl(url) {
        return url == null || (
          url is string &&
          url.size() > 0 &&
          url.size() <= 2048 &&
          url.matches('https://.+')
        );
      }

      // Validate user profile schema
      function isValidProfile() {
        let data = request.resource.data;
        return data.keys().hasAll(['uid', 'email', 'character']) &&
               data.keys().hasOnly(['uid', 'email', 'displayName', 'photoURL', 'character', 'createdAt', 'updatedAt']) &&
               data.uid is string &&
               (data.email == null || data.email is string) &&
               (data.displayName == null || (data.displayName is string && data.displayName.size() <= 50)) &&
               isSafePhotoUrl(data.photoURL) &&
               data.character in ['ball', 'snowboarder', 'skateboarder', 'horse'] &&
               (data.createdAt == null || data.createdAt is timestamp) &&
               (data.updatedAt == null || data.updatedAt is timestamp);
      }

      // Reads: owner only
      allow read: if isOwner();

      // Creates: owner only + uid must match + valid schema
      allow create: if isOwner() && hasMatchingUid() && isValidProfile();

      // Updates: owner only + uid must remain correct + valid schema
      allow update: if isOwner() && hasMatchingUid() && resource.data.uid == uid && isValidProfile();

      // Deletes: owner only
      allow delete: if isOwner();
      
      // ----------------------------------------
      // TRACKS SUBCOLLECTION
      // ----------------------------------------
      // Metadata: /users/{uid}/tracks/{trackId}
      // Segments: /users/{uid}/tracks/{trackId}/parts/segments
      // New tracks must use slot-0 … slot-49 so a client cannot create unbounded documents.
      // Rules cannot loop over segment rows; row shape and coordinate bounds are enforced
      // when the app encodes and decodes tracks.
      match /tracks/{trackId} {
        function isTrackSlot() {
          return trackId.matches('slot-(?:[0-9]|[1-4][0-9])');
        }

        function isInWorld(value) {
          return value is number && value >= -1000000 && value <= 1000000;
        }

        function isValidRiderStart(riderStart) {
          return riderStart is map &&
                 riderStart.keys().hasAll(['x', 'y']) &&
                 riderStart.keys().hasOnly(['x', 'y']) &&
                 isInWorld(riderStart.x) &&
                 isInWorld(riderStart.y);
        }

        function isValidTrackMeta() {
          let data = request.resource.data;
          return data.keys().hasAll([
                   'name',
                   'version',
                   'segmentCount',
                   'riderStart',
                   'character',
                   'updatedAt'
                 ]) &&
                 data.keys().hasOnly([
                   'name',
                   'version',
                   'segmentCount',
                   'riderStart',
                   'character',
                   'createdAt',
                   'updatedAt'
                 ]) &&
                 data.name is string &&
                 data.name.size() > 0 &&
                 data.name.size() <= 100 &&
                 data.version == 1 &&
                 data.segmentCount is int &&
                 data.segmentCount >= 0 &&
                 data.segmentCount <= 12000 &&
                 isValidRiderStart(data.riderStart) &&
                 data.character in ['ball', 'snowboarder', 'skateboarder', 'horse'] &&
                 (data.createdAt == null || data.createdAt is timestamp) &&
                 data.updatedAt is timestamp;
        }

        allow read: if isOwner();
        allow create: if isOwner() && isTrackSlot() && isValidTrackMeta();
        allow update: if isOwner() && isValidTrackMeta();
        allow delete: if isOwner();

        match /parts/{partId} {
          function isValidSegmentsPart() {
            let data = request.resource.data;
            let parentPath = /databases/$(database)/documents/users/$(uid)/tracks/$(trackId);
            return partId == 'segments' &&
                   data.keys().hasOnly(['segments']) &&
                   data.segments is list &&
                   data.segments.size() <= 12000 &&
                   data.segments.size() == getAfter(parentPath).data.segmentCount;
          }

          allow read: if isOwner();
          allow create, update: if isOwner() && isValidSegmentsPart();
          allow delete: if isOwner();
        }
      }
    }
    
    // ============================================
    // DENY ALL OTHER ACCESS
    // ============================================
    // Any path not explicitly matched above is denied by default.
    // /users/{uid}/settings is intentionally not writable.
    
  }
}
