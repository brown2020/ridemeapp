rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    
    // ============================================
    // USER FILES
    // ============================================
    // All user files must be under /users/{uid}/
    // Only the authenticated owner can read/write
    
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function isBitmapImage() {
      return request.resource != null &&
             request.resource.contentType.matches('image/(png|jpeg|webp|gif)');
    }

    // Avatars: bitmap images only (5MB). Deletes are separate because
    // request.resource is null when a file is removed.
    match /users/{uid}/avatars/{fileName} {
      allow read: if isOwner(uid);
      allow create, update: if isOwner(uid)
                   && request.resource.size < 5 * 1024 * 1024
                   && isBitmapImage();
      allow delete: if isOwner(uid);
    }

    // Track thumbnails: bitmap images up to 2MB
    match /users/{uid}/tracks/{trackId}/{fileName} {
      allow read: if isOwner(uid);
      allow create, update: if isOwner(uid)
                   && request.resource.size < 2 * 1024 * 1024
                   && isBitmapImage();
      allow delete: if isOwner(uid);
    }

    // ============================================
    // DENY ALL OTHER ACCESS
    // ============================================
    // Only explicitly matched paths above are allowed.
    // Any path not under a specific match rule is denied by default.
    
  }
}
